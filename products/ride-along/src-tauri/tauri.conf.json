{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BikeBridge",
  "version": "0.1.0",
  "identifier": "com.bikebridge.ridealong",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Ride Along", "width": 380, "height": 520,
      "minWidth": 320, "minHeight": 240, "resizable": true,
      "decorations": false, "alwaysOnTop": true, "visibleOnAllWorkspaces": true,
      "backgroundColor": "#171d21", "shadow": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Bluetooth cycling, ride companion, and stream overlays in one app.",
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
